PORT=4000

# --- Chrome ---
# Leave empty to auto-detect installed Google Chrome
CHROME_PATH=
CHROME_PROFILE_DIR=./chrome-profile
# false = visible window (needed so a human can solve captchas). On a Linux VPS run under Xvfb.
HEADLESS=false
# true = block images/fonts/media (saves bandwidth, but the page no longer looks like a real browser)
BLOCK_ASSETS=false
# Restart Chrome after this many jobs (prevents memory creep)
BROWSER_MAX_JOBS=50

# --- Jobs ---
JOB_TIMEOUT_MS=360000
JOB_GAP_MS=1500
MAX_QUEUE=50
RATE_LIMIT_PER_MIN=5
STEP_TIMEOUT_MS=30000

# --- Captcha (human-in-the-loop) ---
CAPTCHA_WAIT_MS=180000
# Optional: POST {event:"captcha_required", playerId, ...} here (e.g. your Telegram bot endpoint)
ALERT_WEBHOOK=

# --- Shop defaults (each can be overridden per request) ---
SHOP_ORIGIN=https://shop.garena.my
APP_ID=100067
CHANNEL_ID=221179
SHOP_REGION=MY
PLAYER_REGION=BD
PAYMENT_SELECTOR_1=#pc_div_659
PAYMENT_SELECTOR_2=#pc_div_670
