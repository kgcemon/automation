PORT=4000

# Number of reverse proxies in front of the app (1 = nginx, 0 = none)
TRUST_PROXY=1

# Default UniPin denomination button index when a request has no `denom`
# 0:25 1:50 2:115 3:240 4:610 5:1240 6:2530 Diamond, 7:Weekly, 8:Monthly
DEFAULT_DENOM=0

# Garena session (from your own browser after logging in on shop.garena.my:
# DevTools > Network > pay/init request > Request Headers)
GARENA_COOKIE=
GARENA_CSRF_TOKEN=
GARENA_USER_AGENT=
GARENA_CHANNEL_ID=221179
